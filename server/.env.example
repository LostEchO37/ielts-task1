# MySQL（db4free.net / Aiven 免费 MySQL 等）
MYSQL_HOST=your-host.db4free.net
MYSQL_PORT=3306
MYSQL_USER=your_user
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=ielts_analytics

# 管理页 stats.html 口令
ADMIN_STATS_TOKEN=change-me-to-a-long-random-string

# 用户登录 JWT 签名密钥（可与 ADMIN_STATS_TOKEN 相同，生产环境请单独设置）
JWT_SECRET=change-me-to-a-long-random-string

# 允许的前端来源（GitHub Pages），逗号分隔
CORS_ORIGINS=https://lostecho37.github.io,http://localhost:8765,http://127.0.0.1:8765

# API 端口（Render 会自动注入 PORT）
PORT=3000
